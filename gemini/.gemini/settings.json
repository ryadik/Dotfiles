{
  "general": {
    "checkpointing": {
      "enabled": true
    },
    "preferredEditor": "neovim",
    "previewFeatures": true,
    "enableAutoUpdate": false,
    "enablePromptCompletion": false,
    "defaultApprovalMode": "default",
    "sessionRetention": {
      "warningAcknowledged": true,
      "enabled": true,
      "maxAge": "120d"
    }
  },
  "ui": {
    "customThemes": {
      "tokyonight": {
        "name": "tokyonight",
        "type": "custom",
        "Background": "#1a1b26",
        "Foreground": "#a9b1d6",
        "LightBlue": "#7dcfff",
        "AccentBlue": "#7aa2f7",
        "AccentPurple": "#bb9af7",
        "AccentCyan": "#7dcfff",
        "AccentGreen": "#73daca",
        "AccentYellow": "#e0af68",
        "AccentRed": "#f7768e",
        "DiffAdded": "#283B4D",
        "DiffRemoved": "#3C2C3C",
        "Comment": "#565f89",
        "Gray": "#9aa5ce",
        "GradientColors": [
          "#7aa2f7",
          "#bb9af7"
        ]
      }
    },
    "hideBanner": true,
    "footer": {
      "hideSandboxStatus": true,
      "hideContextPercentage": false,
      "items": [
        "workspace",
        "git-branch",
        "code-changes",
        "context-used",
        "token-count",
        "quota",
        "model-name",
        "memory-usage"
      ]
    },
    "showMemoryUsage": true,
    "showLineNumbers": false,
    "theme": "tokyonight",
    "showStatusInTitle": false,
    "accessibility": {
      "screenReader": false
    },
    "showModelInfoInChat": true
  },
  "advanced": {
    "excludedEnvVars": [
      "DEBUG",
      "DEBUG_MODE",
      "NODE_ENV",
      "VITE"
    ]
  },
  "ide": {
    "hasSeenNudge": true,
    "enabled": true
  },
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp",
        "--api-key",
        "ctx7sk-6a91e6c7-8ffb-4b43-9b4b-66f397d24ebb"
      ]
    },
    "package-registry": {
      "command": "npx",
      "args": [
        "-y",
        "package-registry-mcp"
      ]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    }
  },
  "context": {
    "discoveryMaxDirs": 350
  },
  "security": {
    "auth": {
      "selectedType": "oauth-personal"
    },
    "enablePermanentToolApproval": true,
    "disableYoloMode": true
  },
  "output": {
    "format": "text"
  },
  "experimental": {
    "plan": true
  },
  "tools": {}
}
